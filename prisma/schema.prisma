generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

////////////////////////////////////////////////////////////
// 🔐 SYSTEM / AUTH
////////////////////////////////////////////////////////////

model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_check")
}

model Admin {
  userId    String   @id @db.Uuid @map("user_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin")
}

////////////////////////////////////////////////////////////
// 🗂️ CATEGORY / SUBTYPE
////////////////////////////////////////////////////////////

model Category {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  icon         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  subtypes     Subtype[]
  collectibles Collectible[]

  @@map("category")
}

model Subtype {
  id           Int        @id @default(autoincrement())
  name         String
  categoryId   Int        @map("category_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  category     Category   @relation(fields: [categoryId], references: [id])
  collectibles Collectible[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("subtype")
}

////////////////////////////////////////////////////////////
// 🎬 FRANCHISE / CHARACTER / SERIES
////////////////////////////////////////////////////////////

model Franchise {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  iconUrl      String?    @map("icon_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  characters   Character[]
  series       Series[]
  collectibles Collectible[]

  @@map("franchise")
}

model Character {
  id           Int        @id @default(autoincrement())
  name         String
  franchiseId  Int?       @map("franchise_id")
  iconUrl      String?    @map("icon_url")
  notes        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  franchise    Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  collectibles Collectible[]
  references   CharacterReference[]

  @@unique([name, franchiseId])
  @@index([franchiseId])
  @@map("character")
}

model CharacterReference {
  id           Int           @id @default(autoincrement())
  characterId  Int           @map("character_id")

  type         ReferenceType
  url          String
  label        String?

  createdAt    DateTime      @default(now()) @map("created_at")

  character    Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("character_reference")
}

model Series {
  id           Int          @id @default(autoincrement())
  name         String
  format       SeriesFormat
  totalUnits   Int?         @map("total_units")
  notes        String?
  franchiseId  Int          @map("franchise_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  franchise    Franchise    @relation(fields: [franchiseId], references: [id])
  collectibles Collectible[]
  editions     Edition[]

  @@unique([name, franchiseId])
  @@index([franchiseId])
  @@map("series")
}

////////////////////////////////////////////////////////////
// 🏭 BRAND
////////////////////////////////////////////////////////////

model Brand {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  iconUrl      String?    @map("icon_url")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  collectibles Collectible[]

  @@map("brand")
}

////////////////////////////////////////////////////////////
// 🎯 COLLECTIBLE (MAIN ITEM)
////////////////////////////////////////////////////////////

model Collectible {
  id           Int               @id @default(autoincrement())
  title        String
  description  String?
  imageUrl     String?           @map("image_url")

  status       CollectibleStatus @default(OWNED)

  brandId      Int?              @map("brand_id")
  categoryId   Int               @map("category_id")
  subtypeId    Int               @map("subtype_id")
  franchiseId  Int?              @map("franchise_id")
  seriesId     Int?              @map("series_id")
  characterId  Int?              @map("character_id")

  seriesNumber Int?              @map("series_number")

  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  brand        Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category     Category          @relation(fields: [categoryId], references: [id])
  subtype      Subtype           @relation(fields: [subtypeId], references: [id])
  franchise    Franchise?        @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  series       Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  character    Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)

  editions     Edition[]
  purchases    Purchase[]
  media        Media[]

  @@index([categoryId])
  @@index([seriesId])
  @@index([brandId])
  @@index([status])
  @@index([characterId])
  @@index([seriesNumber])
  @@map("collectible")
}

////////////////////////////////////////////////////////////
// 🎨 EDITION (VARIANTS)
////////////////////////////////////////////////////////////

model Edition {
  id             Int        @id @default(autoincrement())
  collectibleId  Int        @map("collectible_id")
  seriesId       Int?       @map("series_id")

  editionNumber  Int?       @map("edition_number")
  editionName    String?    @map("edition_name")
  exclusiveLabel String?    @map("exclusive_label")

  releaseDate    DateTime?  @map("release_date")
  editionSize    Int?       @map("edition_size")
  sku            String?

  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  collectible    Collectible @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  series         Series?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  purchases      Purchase[]
  media          Media[]

  @@index([collectibleId])
  @@index([seriesId])
  @@map("edition")
}

////////////////////////////////////////////////////////////
// 🧾 PURCHASE (REAL OWNED ITEM)
////////////////////////////////////////////////////////////

model Purchase {
  id             Int            @id @default(autoincrement())
  collectibleId  Int            @map("collectible_id")
  editionId      Int?           @map("edition_id")

  condition      Condition
  status         PurchaseStatus
  purchasedAt    DateTime       @map("purchased_at")

  storeName      String?        @map("store_name")
  receiptUrl     String?        @map("receipt_url")

  purchasePrice  Decimal?       @map("purchase_price") @db.Decimal(10,2)
  taxAmount      Decimal?       @map("tax_amount") @db.Decimal(10,2)
  shippingCost   Decimal?       @map("shipping_cost") @db.Decimal(10,2)
  totalCost      Decimal?       @map("total_cost") @db.Decimal(10,2)

  resaleDate     DateTime?      @map("resale_date")
  resalePrice    Decimal?       @map("resale_price") @db.Decimal(10,2)

  lotId          Int?           @map("lot_id")
  serialNumber   String?        @map("serial_number")
  location       String?

  notes          String?

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  collectible    Collectible    @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  edition        Edition?       @relation(fields: [editionId], references: [id], onDelete: SetNull)
  lot            Lot?           @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([collectibleId])
  @@index([status])
  @@index([purchasedAt])
  @@map("purchase")
}

////////////////////////////////////////////////////////////
// 📦 LOT
////////////////////////////////////////////////////////////

model Lot {
  id        Int        @id @default(autoincrement())
  name      String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  purchases Purchase[]

  @@map("lot")
}

////////////////////////////////////////////////////////////
// 🖼️ MEDIA (IMAGES)
////////////////////////////////////////////////////////////

model Media {
  id            Int          @id @default(autoincrement())
  collectibleId Int?         @map("collectible_id")
  editionId     Int?         @map("edition_id")
  url           String
  createdAt     DateTime     @default(now()) @map("created_at")

  collectible   Collectible? @relation(fields: [collectibleId], references: [id], onDelete: Cascade)
  edition       Edition?     @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("media")
}

////////////////////////////////////////////////////////////
// 🏷️ ENUMS
////////////////////////////////////////////////////////////

enum CollectibleStatus {
  OWNED
  PLANNED
  WISHLIST
}

enum SeriesFormat {
  MANGA
  ANIME
  GAME
  FILM
  MUSIC
  OTHER
}

enum ReferenceType {
  WIKIPEDIA
  OFFICIAL
  FANDOM
  OTHER
}

enum Condition {
  MINT
  NEAR_MINT
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum PurchaseStatus {
  OWNED
  SOLD
  GIFTED
}